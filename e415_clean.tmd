<[file][][]
    <[modelmanager][][]
        <[pointer_list_tmuniverse][DynamicObjects][]

            // engine
            <[input_lever][ThrottleInput][]
                <[float64][Value][0.6]>
            >
            <[servoclassic][ServoThrottle][]
                <[float64][Position][0.6]>
            >
            <[multibody_joint][PropellerJoint][]
                <[float64][InitialVelocity][256.0]>
            >

            // gear bolted down

            // flaps up
            <[input_default][FlapsInput][]
                <[float64][Value][0.0]>
            >
            <[electrical_actuator][FlapsMotor][]
                <[float64][Position][0.0]>
            >

            // maybe lean mixture a bit

            // trim forward
            <[input_default][PitchTrim][]
                <[float64][Value][0.54]>
            >
            <[servoclassic][ServoElevator][]
                <[float64][Position][-0.0455]>
            >

            // lights
            <[input_switch][StrobeLightSwitch][]
                <[float64][Value][1.0]>
            >
            <[input_switch][BeaconLightSwitch][]
                <[float64][Value][1.0]>
            >
            <[input_switch][NavigationLightSwitch][]
                <[float64][Value][1.0]>
            >
            <[input_switch][LandingLightSwitch][]
                <[float64][Value][0.0]>
            >
            <[input_switch][TaxiLightSwitch][]
                <[float64][Value][0.0]>
            >

            // panel state
            <[input_switch][SwitchAvionicsBus1][]
                <[float64][Value][1.0]>
            >
            <[input_switch][SwitchAvionicsBus2][]
                <[float64][Value][1.0]>
            >

            <[input_switch][DMESelectedOn][]
                <[float64][Value][1.0]>
            >
            <[input_default][ADFVolume][]
                <[float64][Value][0.1]>
            >
            <[input_default][COM1Volume][]
                <[float64][Value][0.6]>
            >
            <[input_default][COM2Volume][]
                <[float64][Value][0.1]>
            >
            <[input_discrete][TransponderMode][]
                <[float64][Value][4.0]>
            >
            <[variable][TransponderIdent][]
                <[float64][Value][0.0]>
            >

        >
    >
>

